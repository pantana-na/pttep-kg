# ==============================================================================
# Centralized Multi-Environment Configuration
# Refinery Phenol Process Safety & Multi-Agent Platform
# Rule 8 Compliance: Single unified file for Non-Prod and Prod environments
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Shared Configuration (Common across all environments)
# ------------------------------------------------------------------------------
GCP_PROJECT=cs-poc-y03r7kmfyov4kilzg50fd7s
GCP_REGION=asia-southeast1
GENAI_LOCATION=asia-southeast1
DEFAULT_MODEL=gemini-3.7-flash
REASONING_MODEL=gemini-3.7-flash
SPANNER_INSTANCE=phenol-process-graph
SPANNER_DATABASE=safety-db
ARTIFACT_REGISTRY_REPO=phenol-repo
GITHUB_REPO_URL=https://github.com/pantana-na/pttep-kg.git

# ------------------------------------------------------------------------------
# 2. Non-Prod Environment (Development / Staging / CI-CD)
# ------------------------------------------------------------------------------
NONPROD_ENVIRONMENT_NAME=development
NONPROD_SERVICE_NAME=phenol-process-safety-nonprod
NONPROD_DEPLOYMENT_ID=phenol-container-nonprod
NONPROD_GCS_RAW_BUCKET=phenol-raw-docs-cs-poc-y03r7kmfyov4kilzg50fd7s-nonprod
NONPROD_GCS_WIKI_BUCKET=phenol-llm-wiki-cs-poc-y03r7kmfyov4kilzg50fd7s-nonprod
NONPROD_MIN_INSTANCES=0
NONPROD_MAX_INSTANCES=3
NONPROD_CPU=2000m
NONPROD_MEMORY=2Gi
NONPROD_USE_VERTEXAI=true
# Optional developer API key for local offline testing (leave blank to use Vertex AI ADC)
NONPROD_GEMINI_API_KEY=""

# ------------------------------------------------------------------------------
# 3. Production Environment (Production Enterprise)
# Security Mandate: ZERO GEMINI_API_KEY in Production.
# Uses Google Cloud Vertex AI via Application Default Credentials (ADC) & Service Account IAM.
# ------------------------------------------------------------------------------
PROD_ENVIRONMENT_NAME=production
PROD_SERVICE_NAME=phenol-process-safety-prod
PROD_DEPLOYMENT_ID=phenol-container-prod
PROD_GCS_RAW_BUCKET=phenol-raw-docs-cs-poc-y03r7kmfyov4kilzg50fd7s-prod
PROD_GCS_WIKI_BUCKET=phenol-llm-wiki-cs-poc-y03r7kmfyov4kilzg50fd7s-prod
PROD_MIN_INSTANCES=1
PROD_MAX_INSTANCES=10
PROD_CPU=2000m
PROD_MEMORY=2Gi
PROD_USE_VERTEXAI=true
# Zero API key in production - authentication is strictly managed via Service Account IAM & Vertex AI
PROD_GEMINI_API_KEY=""
PROD_SERVICE_ACCOUNT=phenol-runner-sa@cs-poc-y03r7kmfyov4kilzg50fd7s.iam.gserviceaccount.com
PROD_MODEL_ARMOR_TEMPLATE=phenol-safety-armor-template
